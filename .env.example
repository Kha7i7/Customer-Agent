# ===== 复制为 .env 后填写真实值（.env 不入仓库）=====

# ---- 模型 API ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ---- 向量库 ----
# 本地开发：http://localhost:19530
# 容器内由 docker-compose.prod.yml 覆盖为 http://milvus:19530
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=csagent
COLLECTION_NAME=knowledge_base

# ---- PostgreSQL ----
# 本地开发：postgresql+psycopg2://csagent:csagent123@localhost:5432/csagent
# 容器内由 docker-compose.prod.yml 覆盖为 @postgres:5432
DATABASE_URL=postgresql+psycopg2://csagent:csagent123@localhost:5432/csagent

# compose 里 PostgreSQL 容器的账号密码，生产务必改掉
PG_USER=csagent
PG_PASSWORD=csagent123
PG_DB=csagent

# ---- 登录会话 ----
# 生产必须替换：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string
SESSION_MAX_AGE=604800

# ---- RAG ----
TOP_K=3
RAG_SCORE_THRESHOLD=0.35
CHUNK_SIZE=500
CHUNK_OVERLAP=50
